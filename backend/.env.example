# =============================================================================
# Autor exclusivo deste arquivo: Eduardo Martins Colmati
# Projeto Integrador II - PI-II-TIME-11
#
# MODELO de configuracao. Copie este arquivo para .env e preencha os valores
# da sua maquina:
#
#   Linux ou macOS:  cp backend/.env.example backend/.env
#   Windows:         copy backend\.env.example backend\.env
#
# O arquivo .env contem senhas e NAO deve ser enviado ao GitHub.
# Ele ja esta listado no .gitignore.
# =============================================================================

# Porta em que o sistema vai responder no navegador.
PORTA=3000

# ---------------------------------------------------------------------------
# Banco de dados MySQL
# ---------------------------------------------------------------------------
BANCO_HOST=localhost
BANCO_PORTA=3306
BANCO_USUARIO=root
BANCO_SENHA=coloque_aqui_a_senha_do_seu_mysql
BANCO_NOME=acompanhamento_demandas

# ---------------------------------------------------------------------------
# Chave usada para assinar o token de login.
# Troque por um texto longo e aleatorio. Nunca use este valor de exemplo
# em um sistema de verdade.
# ---------------------------------------------------------------------------
CHAVE_SECRETA_TOKEN=troque_esta_chave_por_um_texto_longo_e_secreto

# Por quanto tempo o usuario continua logado. Exemplos: 30m, 8h, 1d.
VALIDADE_TOKEN=8h

# ---------------------------------------------------------------------------
# API externa de feriados nacionais (BrasilAPI).
# Nao exige cadastro nem chave de acesso.
# ---------------------------------------------------------------------------
URL_API_FERIADOS=https://brasilapi.com.br/api/feriados/v1
